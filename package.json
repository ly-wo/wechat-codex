{
  "name": "wechat-codex",
  "version": "1.0.0-codex.1",
  "description": "WeChat bridge for local Codex CLI, adapted from Wechat-ggGitHub/wechat-claude-code",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "postinstall": "npm run build",
    "start": "node dist/main.js",
    "run": "node dist/main.js start",
    "dev": "tsc --watch",
    "test": "node scripts/test.mjs",
    "setup": "node dist/main.js setup",
    "daemon": "bash scripts/daemon.sh",
    "visualize": "npx tsx src/tools/visualize-logs.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "wechat",
    "codex",
    "bridge",
    "chat",
    "skill"
  ],
  "author": "Wechat-ggGitHub",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ly-wo/wechat-codex.git"
  },
  "engines": {
    "node": ">=18"
  }
}
